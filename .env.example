# Copy this file to .env for local development. Never commit real secrets.

# Required only for explicitly enabled online calls
DASHSCOPE_API_KEY=
BIZINSIGHT_MODEL_NAME=qwen-plus
BIZINSIGHT_EMBEDDING_MODEL=text-embedding-v4
BIZINSIGHT_EMBEDDING_DIMENSIONS=1024
BIZINSIGHT_ENABLE_BUSINESS_MCP=true

# Optional external research; absence enables offline fallback
TAVILY_API_KEY=

# Local paths and safe runtime defaults
BIZINSIGHT_DATABASE_PATH=data/database/bizinsight.sqlite
BIZINSIGHT_KNOWLEDGE_PATH=data/knowledge
BIZINSIGHT_OUTPUT_DIR=outputs
BIZINSIGHT_MAX_QUERY_ROWS=1000
BIZINSIGHT_QUERY_TIMEOUT_SECONDS=30
