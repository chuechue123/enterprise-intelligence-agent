<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>BizInsight 经营诊断报告</title>
<style>body{font-family:"Microsoft YaHei",sans-serif;max-width:1080px;margin:40px auto;padding:0 24px;color:#18212f;line-height:1.7}h1{color:#123b5d}h2{margin-top:34px;border-bottom:2px solid #d9e5ec;padding-bottom:7px}.card{background:#f4f8fa;border-left:4px solid #168aad;padding:12px 18px;margin:12px 0}table{border-collapse:collapse;width:100%}th,td{border:1px solid #ccd8df;padding:8px;text-align:left}img{max-width:100%;height:auto}.muted{color:#637381}a{color:#087e8b}</style></head><body>
<h1>BizInsight 企业经营异常诊断报告</h1><p class="muted">分析问题：{{ question }}</p>
{% for section in sections %}<section><h2>{{ loop.index }}. {{ section }}</h2>
{% if section == "执行摘要" %}<div class="card">本报告仅汇总证据审查通过的 {{ findings|length }} 条结论。{% if findings %}最需关注：{{ findings[0].title }}。{% endif %}</div>
{% elif section == "核心指标概览" %}<table><tr><th>指标</th><th>期间</th><th>数值</th><th>证据</th></tr>{% for finding in findings %}{% for metric in finding.metrics %}<tr><td>{{ metric.metric_name }}</td><td>{{ metric.period }}</td><td>{{ metric.value }} {{ metric.unit }}</td><td>{% for id in metric.evidence_ids %}<a href="#evidence-{{ id|lower }}">{{ id }}</a> {% endfor %}</td></tr>{% endfor %}{% endfor %}</table>{% for chart in charts %}<figure><img src="{{ chart.relative_path }}" alt="{{ chart.title }}"><figcaption>{{ chart.title }}</figcaption></figure>{% endfor %}
{% elif section == "主要异常排名" %}<ol>{% for finding in findings %}<li><strong>{{ finding.title }}</strong>（置信度 {{ "%.0f"|format(finding.confidence * 100) }}%）：{{ finding.fact_statement }} {% for item in finding.evidence %}<a href="#evidence-{{ item.evidence_id|lower }}">{{ item.evidence_id }}</a> {% endfor %}</li>{% endfor %}</ol>
{% elif section == "财务与销售分析" %}<ul>{% for finding in findings if "收入" in finding.title or "销售" in finding.title or "赢单" in finding.title or "毛利" in finding.title %}<li><strong>{{ finding.title }}</strong>：{{ finding.business_interpretation }}</li>{% else %}<li>本次没有该领域的已审查结论。</li>{% endfor %}</ul>
{% elif section == "客户、产品与服务分析" %}<ul>{% for finding in findings if "续费" in finding.title or "客户" in finding.title or "产品" in finding.title or "工单" in finding.title %}<li><strong>{{ finding.title }}</strong>：{{ finding.business_interpretation }}</li>{% else %}<li>本次没有该领域的已审查结论。</li>{% endfor %}</ul>
{% elif section == "项目交付分析" %}<ul>{% for finding in findings if "交付" in finding.title or "验收" in finding.title or "项目" in finding.title %}<li><strong>{{ finding.title }}</strong>：{{ finding.business_interpretation }}</li>{% else %}<li>本次没有该领域的已审查结论。</li>{% endfor %}</ul>
{% elif section == "外部行业背景" %}<ul>{% for finding in findings if not finding.is_key %}<li><strong>{{ finding.title }}</strong>：{{ finding.fact_statement }}</li>{% else %}<li>外部信息仅作背景，当前没有可用实时搜索结果。</li>{% endfor %}</ul>
{% elif section == "根因假设与置信度" %}<ul>{% for finding in findings %}<li>{{ finding.title }}（{{ "%.0f"|format(finding.confidence * 100) }}%）：{{ finding.causal_assessment or "仅陈述关联，尚未确认因果。" }}</li>{% endfor %}</ul>
{% elif section == "行动建议" %}<table><tr><th>优先级</th><th>行动</th><th>依据</th><th>负责人</th><th>时间</th></tr>{% for action in actions %}<tr><td>{{ action.priority }}</td><td>{{ action.action }}</td><td>{{ action.rationale }}</td><td>{{ action.owner_type }}</td><td>{{ action.timeframe }}</td></tr>{% endfor %}</table>
{% elif section == "数据限制与待验证问题" %}<ul>{% for limitation in limitations %}<li>{{ limitation }}</li>{% else %}<li>未发现额外数据限制。</li>{% endfor %}</ul>
{% elif section == "证据索引" %}<ul>{% for item in evidence %}<li id="evidence-{{ item.evidence_id|lower }}"><strong>{{ item.evidence_id }}</strong>｜{{ item.evidence_type.value }}｜{{ item.source }}｜{{ item.locator }}：{{ item.summary }}{% if item.url %}（<a href="{{ item.url }}">来源</a>）{% endif %}</li>{% else %}<li>无证据条目。</li>{% endfor %}</ul>{% endif %}</section>{% endfor %}
</body></html>
